{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": [
    "NODE_ENV", "LOG_LEVEL", "ROOT_DOMAIN", "SCHOOL_PORT", "APP_PROTOCOL", "CONSOLE_URL", "MARKETING_URL", "SITES_IP",
    "DATABASE_URL_MIGRATE", "DATABASE_URL_SCHOOL", "DATABASE_URL_CONSOLE",
    "S3_ENDPOINT", "S3_REGION", "S3_BUCKET", "S3_ACCESS_KEY_ID", "S3_SECRET_ACCESS_KEY", "S3_FORCE_PATH_STYLE",
    "SMTP_HOST", "SMTP_PORT", "SMTP_SECURE", "SMTP_USER", "SMTP_PASS", "MAIL_FROM",
    "CASHFREE_ENV", "CASHFREE_APP_ID", "CASHFREE_SECRET_KEY", "FAKE_PAYMENTS",
    "DATA_KEY", "PLATFORM_GSTIN", "PLATFORM_STATE", "PLATFORM_LEGAL_NAME", "NEXT_TELEMETRY_DISABLED"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "typecheck": {},
    "lint": {},
    "test": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
