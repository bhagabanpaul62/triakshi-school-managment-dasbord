# Copy to .env.local at the repo root. Local values work with `pnpm db:up`.
NODE_ENV=development
ROOT_DOMAIN=localhost
SCHOOL_PORT=4100
APP_PROTOCOL=http

DATABASE_URL_MIGRATE=postgres://app_migrate:app_migrate@127.0.0.1:5433/smw
DATABASE_URL_SCHOOL=postgres://app_school:app_school@127.0.0.1:5433/smw
DATABASE_URL_CONSOLE=postgres://app_console:app_console@127.0.0.1:5433/smw

S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=ap-south-1
S3_BUCKET=smw-files
S3_ACCESS_KEY_ID=smwlocal
S3_SECRET_ACCESS_KEY=smwlocalsecret
S3_FORCE_PATH_STYLE=true

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# Implicit TLS. Leave empty: on for port 465, off (STARTTLS) for 587. See docs/DEV.md, "Email".
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Triakshi <no-reply@yourbrand.com>"
# Emails per day across all schools (Brevo free = 300). 20% is kept for codes and passwords.
MAIL_DAILY_LIMIT=300
# Bounce and spam webhook: POST /api/webhooks/mail with header x-webhook-secret, or the secret as a Bearer token
MAIL_WEBHOOK_SECRET=
# Web push (npx web-push generate-vapid-keys). Empty = push hidden.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Encrypts payroll identity and bank numbers (32+ random characters, e.g. `openssl rand -base64 32`). Empty is fine locally; never change it once used.
DATA_KEY=

# Cashfree: leave empty to use the fake gateway. Sandbox keys from merchant.cashfree.com (Developers > API keys).
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Auto-renew (Cashfree subscriptions) is untested: leave false until it passes in the sandbox.
CASHFREE_SUBSCRIPTIONS=false

# Our GST details for invoices
PLATFORM_GSTIN=29ABCDE1234F1Z5
PLATFORM_STATE=Karnataka
PLATFORM_LEGAL_NAME="Triakshi Technologies Pvt Ltd"

# Elastic IP of the EC2 VM: bare custom domains point an A record here
SITES_IP=203.0.113.10
